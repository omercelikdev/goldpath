{
  "__comment": "The generated worker's day-one board: the trigger's health (bus consume/faults for a queue worker, run progress/checkpoint age/item failures for a jobs worker) + every Ring B cross-cutting signal the worker can compose (auth on the management head, tenancy, locking). Datasource: Prometheus scraping the OTel collector. MODULE boards (jobs, notification) live with their packages under packages/Goldpath.<Module>/ops/ — import the ones your manifest enables. Panels stay green-empty until the matching feature is wired: an empty panel names the capability you have not enabled yet.",
  "title": "Goldpath Worker — trigger & cross-cutting features",
  "uid": "goldpath-worker",
  "schemaVersion": 39,
  "tags": ["goldpath", "worker"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Bus consume & faults (MassTransit meter) — faults land in the broker's error queue",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(masstransit_consume[5m]))", "legendFormat": "consume/s" },
        { "expr": "sum(rate(masstransit_consume_fault[5m]))", "legendFormat": "faults/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Consume duration p95 (MassTransit meter)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(masstransit_consume_duration_bucket[5m])) by (le))", "legendFormat": "consume p95" }]
    },
    {
      "type": "timeseries",
      "title": "Run progress (ratio) — every run in flight, by job",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [{ "expr": "goldpath_jobs_run_progress_ratio", "legendFormat": "{{job}}" }]
    },
    {
      "type": "timeseries",
      "title": "Checkpoint age (s) — growth = stuck run (jobs runbook §1)",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "expr": "goldpath_jobs_checkpoint_age_seconds", "legendFormat": "{{job}}" }]
    },
    {
      "type": "timeseries",
      "title": "Item failures / min — the repair queue is filling (jobs runbook §2)",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [{ "expr": "rate(goldpath_jobs_item_failures_total[5m]) * 60", "legendFormat": "{{job}}" }]
    },
    {
      "type": "timeseries",
      "title": "Auth failures on the management head (per 5m) — a spike is an attack or a broken client secret",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum(increase(goldpath_auth_failures_total[5m]))", "legendFormat": "auth failures" },
        { "expr": "sum(increase(goldpath_auth_tenant_binding_rejects_total[5m]))", "legendFormat": "tenant-binding rejects" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tenancy guard (per 5m) — unresolved tenants and write-guard trips are BUGS, not noise",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum(increase(goldpath_tenant_unresolved_total[5m]))", "legendFormat": "unresolved tenant" },
        { "expr": "sum(increase(goldpath_tenant_write_guard_trips_total[5m]))", "legendFormat": "write-guard trips" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Distributed locks — timeouts climbing means contention (or a leaked hold)",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "targets": [
        { "expr": "sum(increase(goldpath_lock_acquire_total{outcome=\"acquired\"}[5m]))", "legendFormat": "acquired" },
        { "expr": "sum(increase(goldpath_lock_acquire_total{outcome=\"timeout\"}[5m]))", "legendFormat": "timeout" },
        { "expr": "histogram_quantile(0.95, sum(rate(goldpath_lock_wait_seconds_bucket[5m])) by (le))", "legendFormat": "wait p95 (s)" }
      ]
    }
  ]
}
